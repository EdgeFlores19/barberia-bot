# Código de acceso a la demo (capa 1). OBLIGATORIO: la app no arranca sin él.
DEMO_CODE=
# Solo desarrollo local: 1 = arrancar sin código (chat web abierto). Nunca en producción.
ALLOW_OPEN_DEMO=

# Chat web: clave para firmar los sid (en Render: generateValue). Vacía = se genera al arrancar.
SESSION_SECRET=
MAX_SESIONES_WEB=2000
RATE_SESION_POR_MIN=10
RATE_MENSAJE_POR_MIN=60
# IP del cliente tras el proxy: 0 = primera de X-Forwarded-For; N = la N-ésima desde la derecha.
IP_DESDE_DERECHA=0

# Presupuesto duro de mensajes (capa 2)
# En local se puede ser generoso; en la demo pública conviene 30 / 200.
MAX_MENSAJES_POR_SESION=30
MAX_MENSAJES_POR_DIA=600

# Base de datos: SQLite es la fuente de verdad de las citas
DB_FILE=barberia.db

# Citas de ejemplo cuando la agenda está vacía (1 = sí, 0 = no)
SEED_DEMO=1

# LLM opcional: sin key funciona con reglas locales
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Calendar opcional. Espejo de las citas + lectura de los eventos que anotes a mano
# para no ofrecer ese horario. Nunca puede tumbar una reserva: si falla, se agenda con SQLite.
# Deja GOOGLE_CALENDAR_ID vacío para desactivarlo. El token necesita permiso de lectura de
# eventos (por ejemplo calendar.events); con solo crear eventos, la lectura falla y avisa.
GOOGLE_CALENDAR_ID=
GOOGLE_TOKEN_JSON=C:/Users/caoz_/AppData/Local/hermes/google_token.json
CALENDAR_TZ=America/Mexico_City
# CALENDAR_BLOQUEO=0 apaga solo la lectura (el espejo sigue). TTL del caché y reintento tras
# un fallo, en segundos.
CALENDAR_BLOQUEO=1
CALENDAR_BLOQUEO_TTL_S=60
CALENDAR_BLOQUEO_REINTENTO_S=120

# Token de administración para GET /api/citas. Vacío = ruta deshabilitada (503).
ADMIN_TOKEN=

# ---------- WhatsApp Cloud API (opcional; sin esto el canal queda apagado) ----------
# WA_MODO=consola imprime los envíos en el log en vez de llamar a Meta.
WA_MODO=graph
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_TOKEN=
WA_PHONE_ID=
# VERIFICAR: versión vigente en el changelog de Meta.
WA_API_VERSION=v26.0
MAX_MENSAJES_POR_SESION_WA=500

# ---------- Seguridad y operación ----------
# Expiración de sesión en minutos (vuelve a "inicio" y purga SESIONES viejas).
SESION_TTL_MIN=30
# Una conversación en manos del barbero no la retoma el bot antes de este TTL.
SESION_HUMANO_TTL_MIN=720
# Aviso de handoff al dueño: sin estas dos, solo se escribe en el log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Allowlist de WhatsApp por últimos 10 dígitos, separados por coma. Vacía = abierto.
WA_ALLOWLIST=
WA_MAX_POR_HORA=12
WA_MAX_POR_DIA=150
WA_MAX_GLOBAL_POR_DIA=750
