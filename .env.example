# Código de acceso a la demo (capa 1)
DEMO_CODE=ambar

# Presupuesto duro de mensajes (capa 2)
# En local se puede ser generoso; en la demo pública conviene 30 / 200.
MAX_MENSAJES_POR_SESION=30
MAX_MENSAJES_POR_DIA=600

# Base de datos: SQLite es la fuente de verdad de las citas
DB_FILE=barberia.db

# Citas de ejemplo cuando la agenda está vacía (1 = sí, 0 = no)
SEED_DEMO=1

# LLM opcional: sin key funciona con reglas locales
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Calendar opcional: solo espejo, nunca bloquea una reserva.
# Deja GOOGLE_CALENDAR_ID vacío para desactivarlo.
GOOGLE_CALENDAR_ID=
GOOGLE_TOKEN_JSON=C:/Users/caoz_/AppData/Local/hermes/google_token.json
CALENDAR_TZ=America/Mexico_City

# Token de administración para GET /api/citas. Vacío = ruta deshabilitada (503).
ADMIN_TOKEN=

# ---------- WhatsApp Cloud API (opcional; sin esto el canal queda apagado) ----------
# WA_MODO=consola imprime los envíos en el log en vez de llamar a Meta.
WA_MODO=graph
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_TOKEN=
WA_PHONE_ID=
# VERIFICAR: versión vigente en el changelog de Meta.
WA_API_VERSION=v26.0
MAX_MENSAJES_POR_SESION_WA=500

# ---------- Seguridad y operación ----------
# Expiración de sesión en minutos (vuelve a "inicio" y purga SESIONES viejas).
SESION_TTL_MIN=30
# Una conversación en manos del barbero no la retoma el bot antes de este TTL.
SESION_HUMANO_TTL_MIN=720
# Aviso de handoff al dueño: sin estas dos, solo se escribe en el log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Allowlist de WhatsApp por últimos 10 dígitos, separados por coma. Vacía = abierto.
WA_ALLOWLIST=
WA_MAX_POR_HORA=12
WA_MAX_POR_DIA=150
WA_MAX_GLOBAL_POR_DIA=750
