# Código de acceso a la demo (capa 1)
DEMO_CODE=navajazo

# Presupuesto duro de mensajes (capa 2)
# En local se puede ser generoso; en la demo pública conviene 30 / 200.
MAX_MENSAJES_POR_SESION=30
MAX_MENSAJES_POR_DIA=200

# Base de datos: SQLite es la fuente de verdad de las citas
DB_FILE=barberia.db

# Citas de ejemplo cuando la agenda está vacía (1 = sí, 0 = no)
SEED_DEMO=1

# LLM opcional: sin key funciona con reglas locales
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Calendar opcional: solo espejo, nunca bloquea una reserva.
# Deja GOOGLE_CALENDAR_ID vacío para desactivarlo.
GOOGLE_CALENDAR_ID=
GOOGLE_TOKEN_JSON=C:/Users/caoz_/AppData/Local/hermes/google_token.json
CALENDAR_TZ=America/Mexico_City
